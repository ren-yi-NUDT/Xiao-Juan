# ============================================================================
# 景区讲解数字人 —— OpenTalking 运行环境
# 被 scripts/*.sh 通过 `start_unified.sh --env <本文件>` 加载（source 方式，支持 $VAR 展开）
# ============================================================================

# ---------- 0. 目录 ----------
DIGITAL_HUMAN_HOME=/home/hw/opentalking-workspace
OPENTALKING_HOME=$DIGITAL_HUMAN_HOME/opentalking
OPENTALKING_MODEL_ROOT=$DIGITAL_HUMAN_HOME/models
OPENTALKING_MODEL_REPO_ROOT=$DIGITAL_HUMAN_HOME/model-repos
OPENTALKING_RUNTIME_ROOT=$DIGITAL_HUMAN_HOME/runtimes

# ---------- 0.1 国内镜像（前端 npm ci / HF 权重下载走镜像）----------
npm_config_registry=https://registry.npmmirror.com
HF_ENDPOINT=https://hf-mirror.com
UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# ---------- 1. 服务端口 ----------
OPENTALKING_API_HOST=0.0.0.0
OPENTALKING_API_PORT=8210
OPENTALKING_WEB_HOST=0.0.0.0
OPENTALKING_WEB_PORT=5173
VITE_BACKEND_PORT=8210

# ---------- 2. 资产与设备 ----------
OPENTALKING_AVATARS_DIR=./examples/avatars
OPENTALKING_EXPORTS_DIR=./data/exports
OPENTALKING_DEFAULT_MODEL=wav2lip
OPENTALKING_TORCH_DEVICE=cuda:0
OPENTALKING_TTS_SAMPLE_RATE=16000
# 留空：自动找系统 ffmpeg，找不到用 imageio-ffmpeg
OPENTALKING_FFMPEG_BIN=
OPENTALKING_LOG_LEVEL=INFO

# ---------- 3. LLM（必填：API Key）----------
# DashScope（阿里云百炼）OpenAI 兼容模式，qwen-flash 便宜且快，够讲解场景
OPENTALKING_LLM_PROVIDER=openai_compatible
OPENTALKING_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENTALKING_LLM_API_KEY=sk-在这里填你自己的百炼APIKey
OPENTALKING_LLM_MODEL=qwen-flash
OPENTALKING_LLM_SYSTEM_PROMPT='你是景区讲解员，用简洁、口语化、有画面感的中文回答，单次回答不超过 120 字，先说结论再补一个细节。'

# 可选：改成本机 Ollama（隐私优先，需先 ollama pull 模型）
# OPENTALKING_LLM_BASE_URL=http://127.0.0.1:11434/v1
# OPENTALKING_LLM_API_KEY=ollama
# OPENTALKING_LLM_MODEL=qwen2.5:7b-instruct

# ---------- 4. STT 语音识别 ----------
# 默认本地 SenseVoice（免 Key，需先下载模型；见 docs/部署手册.md）
OPENTALKING_STT_DEFAULT_PROVIDER=dashscope
OPENTALKING_STT_ENABLED_PROVIDERS=sensevoice,dashscope,openai_compatible
OPENTALKING_LOCAL_AUDIO_MODEL_ROOT=$OPENTALKING_MODEL_ROOT/local-audio
OPENTALKING_STT_SENSEVOICE_MODEL=iic/SenseVoiceSmall
OPENTALKING_STT_SENSEVOICE_MODEL_DIR=$OPENTALKING_LOCAL_AUDIO_MODEL_ROOT/iic__SenseVoiceSmall
OPENTALKING_STT_SENSEVOICE_DEVICE=cuda:0
# 想省事就切 DashScope（复用 LLM 的 Key）
# OPENTALKING_STT_DEFAULT_PROVIDER=dashscope
OPENTALKING_STT_DASHSCOPE_MODEL=paraformer-realtime-v2
OPENTALKING_STT_DASHSCOPE_API_KEY=$OPENTALKING_LLM_API_KEY

# ---------- 5. TTS 声音 ----------
# 默认 Edge TTS：免费、无需 Key；女声亲和型
OPENTALKING_TTS_DEFAULT_PROVIDER=edge
OPENTALKING_TTS_ENABLED_PROVIDERS=edge,dashscope,xiaomi_mimo,local_cosyvoice
OPENTALKING_TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural
# 备选音色：zh-CN-XiaoyiNeural（年轻女声）/ zh-CN-XiaohanNeural（温柔）/
#           zh-CN-XiaomengNeural（活泼）/ zh-CN-YunxiNeural（男声）

# 想要"景区专属音色"（音色克隆）时启用下面一组
# OPENTALKING_TTS_DEFAULT_PROVIDER=dashscope
# OPENTALKING_TTS_DASHSCOPE_MODEL=qwen3-tts-flash-realtime
# OPENTALKING_TTS_DASHSCOPE_VOICE=Cherry
# OPENTALKING_TTS_DASHSCOPE_API_KEY=$OPENTALKING_LLM_API_KEY

# ---------- 6. 知识库（LightRAG）----------
OPENTALKING_AGENT_KNOWLEDGE_ROOT=./data/knowledge
OPENTALKING_AGENT_LIGHTRAG_QUERY_MODE=hybrid
OPENTALKING_AGENT_LIGHTRAG_EMBEDDING_MODEL=text-embedding-v4
OPENTALKING_AGENT_LIGHTRAG_EMBEDDING_DIM=1024
OPENTALKING_AGENT_LIGHTRAG_EMBEDDING_BASE_URL=$OPENTALKING_LLM_BASE_URL
OPENTALKING_AGENT_LIGHTRAG_EMBEDDING_API_KEY=$OPENTALKING_LLM_API_KEY
# DashScope text-embedding-v4 单次请求最多接受 10 条输入；
# LightRAG 默认按 16 条一批送会直接 400（batch size is invalid, should not be larger than 10）。
# 这里压到 8，留出余量。索引大知识库时必须保留这一行。
OPENTALKING_KNOWLEDGE_EMBEDDING_BATCH_SIZE=8
OPENTALKING_KNOWLEDGE_EMBEDDING_CONCURRENCY=2

# ---------- 7. 记忆 ----------
OPENTALKING_MEMORY_SUMMARY_ENABLED=true
OPENTALKING_MEMORY_SUMMARY_TURN_WINDOW=8
OPENTALKING_MEMORY_SUMMARY_MAX_ITEMS=3

# ---------- 8. 数字人模型 ----------
# Wav2Lip 本地（8 GB 显存可用）
OPENTALKING_WAV2LIP_BACKEND=local
OPENTALKING_WAV2LIP_MODEL_ROOT=$OPENTALKING_MODEL_ROOT/wav2lip
OPENTALKING_WAV2LIP_DEVICE=cuda:0
OPENTALKING_WAV2LIP_BATCH_SIZE=4
OPENTALKING_WAV2LIP_MAX_LONG_EDGE=832

# QuickTalk 本地（口型更自然；权重需自行获取）
# OPENTALKING_DEFAULT_MODEL=quicktalk
# OPENTALKING_QUICKTALK_BACKEND=local
# OPENTALKING_QUICKTALK_ASSET_ROOT=$OPENTALKING_MODEL_ROOT/quicktalk
# OPENTALKING_QUICKTALK_WORKER_CACHE=1
# 8 GB 显存建议把分辨率压到 512x640 左右再试
